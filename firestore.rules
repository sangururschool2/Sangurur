rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && (
        request.auth.token.email_verified == true ||
        request.auth.token.firebase.sign_in_provider == 'custom'
      );
    }

    function isBootstrappedAdmin() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email in ['sangururschool10@gmail.com', 'sangururschool2@gmail.com'];
    }

    function teacherExists(uid) {
      return exists(/databases/$(database)/documents/teachers/$(uid));
    }

    function teacherData(uid) {
      return get(/databases/$(database)/documents/teachers/$(uid)).data;
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isSignedIn() &&
        teacherExists(request.auth.uid) &&
        teacherData(request.auth.uid).active != false &&
        teacherData(request.auth.uid).role in ['admin', 'super_admin']
      );
    }

    function isTeacherOrAdmin() {
      return isAdmin() || (
        isSignedIn() &&
        teacherExists(request.auth.uid) &&
        teacherData(request.auth.uid).active != false
      );
    }

    // Staff account created without a Google UID or school admins can manage school-wide cohorts
    function isStaffWideAccess() {
      return isAdmin() || (
        isSignedIn() &&
        request.auth.uid == 'teacher_default_staff' &&
        isTeacherOrAdmin()
      );
    }

    function isLearnerUser() {
      return isSignedIn() && exists(/databases/$(database)/documents/learners/$(request.auth.uid));
    }

    function ownsCohort(cohortId) {
      return isStaffWideAccess() || (
        isTeacherOrAdmin() &&
        exists(/databases/$(database)/documents/cohorts/$(cohortId)) &&
        get(/databases/$(database)/documents/cohorts/$(cohortId)).data.teacherId == request.auth.uid
      );
    }

    // Teachers Collection: Authenticated staff profiles only
    function isValidTeacher(data) {
      return data.keys().hasAll(['uid', 'email', 'fullName', 'role']) &&
             data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 128 &&
             data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 128 &&
             data.role in ['teacher', 'admin', 'super_admin'];
    }

    match /teachers/{teacherId} {
      allow get: if isValidId(teacherId) && isSignedIn() && (request.auth.uid == teacherId || isTeacherOrAdmin());
      allow list: if isSignedIn() && isTeacherOrAdmin();
      allow create: if isValidId(teacherId) &&
                       isSignedIn() &&
                       isValidTeacher(incoming()) &&
                       (
                         (request.auth.uid == teacherId && (incoming().role == 'teacher' || isBootstrappedAdmin())) ||
                         isAdmin()
                       );
      allow update: if isValidId(teacherId) &&
                       isSignedIn() &&
                       isValidTeacher(incoming()) &&
                       incoming().uid == existing().uid &&
                       (
                         isAdmin() ||
                         (request.auth.uid == teacherId && incoming().role == existing().role)
                       );
      allow delete: if isValidId(teacherId) && isAdmin();
    }

    // Teacher Credentials Collection: Strictly server-side Admin SDK only (never client-readable)
    match /teacherCredentials/{credId} {
      allow read, write: if false;
    }

    // Learners Collection: Authenticated staff + self-read for signed-in learner
    function isValidLearner(data) {
      return data.keys().hasAll(['fullName', 'learnerId', 'username']) &&
             data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 128 &&
             data.learnerId is string && data.learnerId.size() > 0 && data.learnerId.size() <= 64 &&
             data.username is string && data.username.size() > 0 && data.username.size() <= 64 &&
             (!data.keys().hasAny(['digitalId']) || data.digitalId == null || (data.digitalId is string && data.digitalId.size() <= 64)) &&
             (!data.keys().hasAny(['schoolName']) || data.schoolName == null || (data.schoolName is string && data.schoolName.size() <= 128)) &&
             (!data.keys().hasAny(['grade']) || data.grade == null || (data.grade is string && data.grade.size() <= 64)) &&
             (!data.keys().hasAny(['gender']) || data.gender == null || data.gender in ['male', 'female', 'other', 'prefer_not_to_say']) &&
             (!data.keys().hasAny(['age']) || data.age == null || (data.age is number && data.age >= 3 && data.age <= 25)) &&
             (!data.keys().hasAny(['guardianContact']) || data.guardianContact == null || (data.guardianContact is string && data.guardianContact.size() <= 64)) &&
             (!data.keys().hasAny(['status']) || data.status in ['ACTIVE', 'INACTIVE', 'ARCHIVED']) &&
             (!data.keys().hasAny(['active']) || data.active is bool) &&
             (!data.keys().hasAny(['assignedCohortIds']) || (data.assignedCohortIds is list && data.assignedCohortIds.size() <= 20)) &&
             (!data.keys().hasAny(['assignedClassIds']) || (data.assignedClassIds is list && data.assignedClassIds.size() <= 20)) &&
             (!data.keys().hasAny(['levelId']) || data.levelId == null || (data.levelId is string && data.levelId.size() <= 128)) &&
             (!data.keys().hasAny(['levelName']) || data.levelName == null || (data.levelName is string && data.levelName.size() <= 128)) &&
             (!data.keys().hasAny(['classId']) || data.classId == null || (data.classId is string && data.classId.size() <= 128)) &&
             (!data.keys().hasAny(['className']) || data.className == null || (data.className is string && data.className.size() <= 128));
    }

    match /learners/{learnerId} {
      allow get: if isValidId(learnerId) && isSignedIn() && (isTeacherOrAdmin() || request.auth.uid == learnerId);
      allow list: if isSignedIn() && isTeacherOrAdmin();
      allow create: if isValidId(learnerId) && isSignedIn() && isTeacherOrAdmin() && isValidLearner(incoming());
      allow update: if isValidId(learnerId) &&
                       isSignedIn() &&
                       isValidLearner(incoming()) &&
                       incoming().learnerId == existing().learnerId &&
                       incoming().username == existing().username &&
                       (
                         isAdmin() ||
                         (isTeacherOrAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
                           'fullName',
                           'schoolName',
                           'gender',
                           'age',
                           'guardianContact',
                           'assignedCohortIds',
                           'assignedClassIds',
                           'levelId',
                           'levelName',
                           'classId',
                           'className',
                           'grade',
                           'passwordHash',
                           'salt',
                           'mustChangePassword',
                           'isFirstLogin',
                           'status',
                           'active',
                           'sessionRevokedAt',
                           'passwordResetAt',
                           'updatedAt'
                         ]))
                       );
      allow delete: if isValidId(learnerId) && isSignedIn() && isStaffWideAccess();
    }

    // Atomic Sequence Counters: Server-side Admin SDK only
    match /counters/{counterId} {
      allow read, write: if false;
    }

    // Cohorts Collection: Enforces teacher cohort ownership + admin oversight
    function isValidCohort(data) {
      return data.keys().hasAll(['name', 'code', 'programme', 'teacherId', 'status']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 128 &&
             data.code is string && data.code.size() > 0 && data.code.size() <= 64 &&
             data.programme is string && data.programme.size() > 0 && data.programme.size() <= 128 &&
             data.teacherId is string && data.teacherId.size() > 0 && data.teacherId.size() <= 128 &&
             data.status in ['active', 'archived', 'draft'] &&
             (!data.keys().hasAny(['ageBracket']) || data.ageBracket == null || (data.ageBracket is string && data.ageBracket.size() <= 64));
    }

    match /cohorts/{cohortId} {
      allow get: if isValidId(cohortId) && isSignedIn() && (
        isStaffWideAccess() ||
        (isTeacherOrAdmin() && resource.data.teacherId == request.auth.uid) ||
        (isLearnerUser() && (
          cohortId in get(/databases/$(database)/documents/learners/$(request.auth.uid)).data.assignedCohortIds ||
          resource.data.code in get(/databases/$(database)/documents/learners/$(request.auth.uid)).data.assignedCohortIds
        ))
      );
      allow list: if isSignedIn() && (
        isStaffWideAccess() ||
        (isTeacherOrAdmin() && resource.data.teacherId == request.auth.uid)
      );
      allow create: if isValidId(cohortId) &&
                       isSignedIn() &&
                       isValidCohort(incoming()) &&
                       (isAdmin() || (isTeacherOrAdmin() && incoming().teacherId == request.auth.uid));
      allow update: if isValidId(cohortId) &&
                       isSignedIn() &&
                       isValidCohort(incoming()) &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         isStaffWideAccess() ||
                         (isTeacherOrAdmin() && existing().teacherId == request.auth.uid && incoming().teacherId == existing().teacherId)
                       );
      allow delete: if isValidId(cohortId) &&
                       isSignedIn() &&
                       (
                         isStaffWideAccess() ||
                         (isTeacherOrAdmin() && existing().teacherId == request.auth.uid)
                       );
    }

    // Cohort Members Collection: Enforces cohort ownership + learner self-read
    function isValidCohortMember(data) {
      return data.keys().hasAll(['cohortId', 'learnerId']) &&
             data.cohortId is string && data.cohortId.size() > 0 && data.cohortId.size() <= 128 &&
             data.learnerId is string && data.learnerId.size() > 0 && data.learnerId.size() <= 128;
    }

    match /cohortMembers/{memberId} {
      allow get, list: if isSignedIn() && (
        isStaffWideAccess() ||
        ownsCohort(resource.data.cohortId) ||
        (isLearnerUser() && resource.data.learnerId == request.auth.uid)
      );
      allow create, update: if isValidId(memberId) &&
                               isSignedIn() &&
                               isValidCohortMember(incoming()) &&
                               ownsCohort(incoming().cohortId);
      allow delete: if isValidId(memberId) &&
                       isSignedIn() &&
                       ownsCohort(existing().cohortId);
    }

    // Curricula Collection: Readable by authenticated staff & learners; editable by teachers/admins
    function isValidCurriculum(data) {
      return data.keys().hasAll(['title', 'description', 'learningAreas']) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 128 &&
             data.description is string && data.description.size() <= 2048 &&
             data.learningAreas is list;
    }

    match /curricula/{curriculumId} {
      allow get, list: if isSignedIn() && (isTeacherOrAdmin() || isLearnerUser());
      allow create, update: if isValidId(curriculumId) &&
                               isSignedIn() &&
                               isValidCurriculum(incoming()) &&
                               isTeacherOrAdmin();
      allow delete: if isValidId(curriculumId) && isAdmin();
    }

    // Daily Registers Collection: Cohort-owned teacher writes + strict learner self-ownership
    function isValidDailyRegister(data) {
      return data.keys().hasAll(['cohortId', 'learnerDocId', 'date', 'status']) &&
             data.keys().hasOnly([
               'id', 'cohortId', 'cohortCode', 'levelId', 'levelName', 'classId', 'className',
               'learnerDocId', 'learnerId', 'learnerName', 'date', 'timestamp', 'status',
               'didStudy', 'nonStudyReason', 'verificationStatus', 'learningAreaId',
               'learningAreaTitle', 'moduleId', 'moduleTitle', 'topicId', 'topicTitle',
               'topicDescription', 'understandingLevel', 'reflectionLearned',
               'reflectionActivity', 'reflectionDifficult', 'reflectionTeacherExplain',
               'teacherNote', 'reviewedBy', 'reviewedAt', 'correctionHistory'
             ]) &&
             data.cohortId is string && data.cohortId.size() > 0 && data.cohortId.size() <= 128 &&
             data.learnerDocId is string && data.learnerDocId.size() > 0 && data.learnerDocId.size() <= 128 &&
             data.date is string && data.date.size() == 10 &&
             data.status in ['present', 'late', 'absent', 'excused'] &&
             (!data.keys().hasAny(['id']) || (data.id is string && data.id.size() <= 128)) &&
             (!data.keys().hasAny(['cohortCode']) || data.cohortCode == null || (data.cohortCode is string && data.cohortCode.size() <= 64)) &&
             (!data.keys().hasAny(['levelId']) || data.levelId == null || (data.levelId is string && data.levelId.size() <= 128)) &&
             (!data.keys().hasAny(['levelName']) || data.levelName == null || (data.levelName is string && data.levelName.size() <= 128)) &&
             (!data.keys().hasAny(['classId']) || data.classId == null || (data.classId is string && data.classId.size() <= 128)) &&
             (!data.keys().hasAny(['className']) || data.className == null || (data.className is string && data.className.size() <= 128)) &&
             (!data.keys().hasAny(['learnerId']) || data.learnerId == null || (data.learnerId is string && data.learnerId.size() <= 64)) &&
             (!data.keys().hasAny(['learnerName']) || data.learnerName == null || (data.learnerName is string && data.learnerName.size() <= 128)) &&
             (!data.keys().hasAny(['timestamp']) || (data.timestamp is string && data.timestamp.size() <= 64)) &&
             (!data.keys().hasAny(['didStudy']) || data.didStudy == null || data.didStudy is bool) &&
             (!data.keys().hasAny(['nonStudyReason']) || data.nonStudyReason == null || (data.nonStudyReason is string && data.nonStudyReason.size() <= 256)) &&
             (!data.keys().hasAny(['verificationStatus']) || data.verificationStatus in ['pending_verification', 'verified', 'corrected']) &&
             (!data.keys().hasAny(['learningAreaId']) || data.learningAreaId == null || (data.learningAreaId is string && data.learningAreaId.size() <= 128)) &&
             (!data.keys().hasAny(['learningAreaTitle']) || data.learningAreaTitle == null || (data.learningAreaTitle is string && data.learningAreaTitle.size() <= 128)) &&
             (!data.keys().hasAny(['moduleId']) || data.moduleId == null || (data.moduleId is string && data.moduleId.size() <= 128)) &&
             (!data.keys().hasAny(['moduleTitle']) || data.moduleTitle == null || (data.moduleTitle is string && data.moduleTitle.size() <= 128)) &&
             (!data.keys().hasAny(['topicId']) || data.topicId == null || (data.topicId is string && data.topicId.size() <= 128)) &&
             (!data.keys().hasAny(['topicTitle']) || data.topicTitle == null || (data.topicTitle is string && data.topicTitle.size() <= 128)) &&
             (!data.keys().hasAny(['topicDescription']) || data.topicDescription == null || (data.topicDescription is string && data.topicDescription.size() <= 512)) &&
             (!data.keys().hasAny(['understandingLevel']) || data.understandingLevel == null || data.understandingLevel in ['excellent', 'good', 'fair', 'needs_support']) &&
             (!data.keys().hasAny(['reflectionLearned']) || data.reflectionLearned == null || (data.reflectionLearned is string && data.reflectionLearned.size() <= 1024)) &&
             (!data.keys().hasAny(['reflectionActivity']) || data.reflectionActivity == null || (data.reflectionActivity is string && data.reflectionActivity.size() <= 1024)) &&
             (!data.keys().hasAny(['reflectionDifficult']) || data.reflectionDifficult == null || (data.reflectionDifficult is string && data.reflectionDifficult.size() <= 1024)) &&
             (!data.keys().hasAny(['reflectionTeacherExplain']) || data.reflectionTeacherExplain == null || (data.reflectionTeacherExplain is string && data.reflectionTeacherExplain.size() <= 1024)) &&
             (!data.keys().hasAny(['teacherNote']) || data.teacherNote == null || (data.teacherNote is string && data.teacherNote.size() <= 1024)) &&
             (!data.keys().hasAny(['reviewedBy']) || data.reviewedBy == null || (data.reviewedBy is string && data.reviewedBy.size() <= 128)) &&
             (!data.keys().hasAny(['reviewedAt']) || data.reviewedAt == null || (data.reviewedAt is string && data.reviewedAt.size() <= 64)) &&
             (!data.keys().hasAny(['correctionHistory']) || (data.correctionHistory is list && data.correctionHistory.size() <= 50));
    }

    function isLearnerEligibleForCohort(cohortId) {
      return isLearnerUser() &&
             get(/databases/$(database)/documents/learners/$(request.auth.uid)).data.status != 'INACTIVE' &&
             get(/databases/$(database)/documents/learners/$(request.auth.uid)).data.active != false &&
             get(/databases/$(database)/documents/learners/$(request.auth.uid)).data.mustChangePassword != true &&
             exists(/databases/$(database)/documents/cohorts/$(cohortId)) &&
             get(/databases/$(database)/documents/cohorts/$(cohortId)).data.status == 'active' &&
             (
               cohortId in get(/databases/$(database)/documents/learners/$(request.auth.uid)).data.assignedCohortIds ||
               get(/databases/$(database)/documents/cohorts/$(cohortId)).data.code in get(/databases/$(database)/documents/learners/$(request.auth.uid)).data.assignedCohortIds ||
               exists(/databases/$(database)/documents/cohortMembers/$(('mem_' + cohortId + '_' + request.auth.uid)))
             );
    }

    function isValidTeacherRegisterUpdate() {
      return incoming().cohortId == existing().cohortId &&
             incoming().learnerDocId == existing().learnerDocId &&
             incoming().date == existing().date &&
             incoming().status in ['present', 'late', 'absent', 'excused'] &&
             (!incoming().keys().hasAny(['verificationStatus']) || incoming().verificationStatus in ['pending_verification', 'verified', 'corrected']) &&
             (!incoming().keys().hasAny(['teacherNote']) || incoming().teacherNote == null || (incoming().teacherNote is string && incoming().teacherNote.size() <= 1024)) &&
             (!incoming().keys().hasAny(['reviewedBy']) || incoming().reviewedBy == null || (incoming().reviewedBy is string && incoming().reviewedBy.size() <= 128)) &&
             (!incoming().keys().hasAny(['reviewedAt']) || incoming().reviewedAt == null || (incoming().reviewedAt is string && incoming().reviewedAt.size() <= 64)) &&
             (!incoming().keys().hasAny(['correctionHistory']) || incoming().correctionHistory == null || (incoming().correctionHistory is list && incoming().correctionHistory.size() <= 50)) &&
             incoming().diff(existing()).affectedKeys().hasOnly([
               'verificationStatus', 'reviewedBy', 'reviewedAt',
               'status', 'teacherNote', 'correctionHistory',
               'cohortCode', 'learnerId', 'learnerName',
               'topicTitle', 'understandingLevel'
             ]);
    }

    match /dailyRegisters/{registerId} {
      allow get, list: if isSignedIn() && (
        isStaffWideAccess() ||
        ownsCohort(resource.data.cohortId) ||
        (isLearnerUser() && resource.data.learnerDocId == request.auth.uid)
      );
      allow create: if isValidId(registerId) &&
                       isSignedIn() &&
                       isValidDailyRegister(incoming()) &&
                       (
                         ownsCohort(incoming().cohortId) ||
                         (
                           registerId == ('reg_' + incoming().cohortId + '_' + request.auth.uid + '_' + incoming().date) &&
                           incoming().learnerDocId == request.auth.uid &&
                           incoming().status in ['present', 'late'] &&
                           incoming().verificationStatus == 'pending_verification' &&
                           (!incoming().keys().hasAny(['teacherNote', 'reviewedBy', 'reviewedAt']) || (
                             (!incoming().keys().hasAny(['teacherNote']) || incoming().teacherNote == null) &&
                             (!incoming().keys().hasAny(['reviewedBy']) || incoming().reviewedBy == null) &&
                             (!incoming().keys().hasAny(['reviewedAt']) || incoming().reviewedAt == null)
                           )) &&
                           isLearnerEligibleForCohort(incoming().cohortId)
                         )
                       );
      allow update: if isValidId(registerId) &&
                       isSignedIn() &&
                       incoming().cohortId == existing().cohortId &&
                       incoming().learnerDocId == existing().learnerDocId &&
                       incoming().date == existing().date &&
                       (
                         (ownsCohort(existing().cohortId) && isValidTeacherRegisterUpdate()) ||
                         (
                           isValidDailyRegister(incoming()) &&
                           registerId == ('reg_' + existing().cohortId + '_' + request.auth.uid + '_' + existing().date) &&
                           existing().learnerDocId == request.auth.uid &&
                           !(existing().status in ['absent', 'excused']) &&
                           incoming().status in ['present', 'late'] &&
                           incoming().verificationStatus == existing().verificationStatus &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'status', 'didStudy', 'nonStudyReason',
                             'learningAreaId', 'learningAreaTitle',
                             'moduleId', 'moduleTitle',
                             'topicId', 'topicTitle', 'topicDescription',
                             'understandingLevel', 'reflectionLearned',
                             'reflectionActivity', 'reflectionDifficult',
                             'reflectionTeacherExplain', 'timestamp'
                           ]) &&
                           isLearnerEligibleForCohort(existing().cohortId)
                         )
                       );
      allow delete: if isValidId(registerId) && isSignedIn() && (isStaffWideAccess() || ownsCohort(existing().cohortId));
    }

    // Teacher Feedback Collection: Author teacher / learner recipient / admin only
    function isValidTeacherFeedback(data) {
      return data.keys().hasAll(['teacherId', 'learnerDocId', 'message']) &&
             data.teacherId is string && data.teacherId.size() > 0 && data.teacherId.size() <= 128 &&
             data.learnerDocId is string && data.learnerDocId.size() > 0 && data.learnerDocId.size() <= 128 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 2048;
    }

    match /teacherFeedback/{feedbackId} {
      allow get, list: if isSignedIn() && (
        isStaffWideAccess() ||
        (isTeacherOrAdmin() && resource.data.teacherId == request.auth.uid) ||
        (isLearnerUser() && resource.data.learnerDocId == request.auth.uid)
      );
      allow create: if isValidId(feedbackId) &&
                       isSignedIn() &&
                       isValidTeacherFeedback(incoming()) &&
                       isTeacherOrAdmin() &&
                       (isAdmin() || incoming().teacherId == request.auth.uid);
      allow update: if isValidId(feedbackId) &&
                       isSignedIn() &&
                       isValidTeacherFeedback(incoming()) &&
                       (isAdmin() || (isTeacherOrAdmin() && existing().teacherId == request.auth.uid));
      allow delete: if isValidId(feedbackId) && isSignedIn() && (isStaffWideAccess() || (isTeacherOrAdmin() && existing().teacherId == request.auth.uid));
    }

    // Mastery Certifications Collection: Cohort-owned teacher writes + learner self-read
    function isValidMasteryCert(data) {
      return data.keys().hasAll(['cohortId', 'learnerId', 'certified']) &&
             data.cohortId is string && data.cohortId.size() <= 128 &&
             data.learnerId is string && data.learnerId.size() <= 128 &&
             data.certified is bool;
    }

    match /masteryCertifications/{certId} {
      allow get, list: if isSignedIn() && (
        isStaffWideAccess() ||
        ownsCohort(resource.data.cohortId) ||
        (isLearnerUser() && resource.data.learnerId == request.auth.uid)
      );
      allow create, update: if isValidId(certId) &&
                               isSignedIn() &&
                               isValidMasteryCert(incoming()) &&
                               ownsCohort(incoming().cohortId);
      allow delete: if isValidId(certId) && isSignedIn() && (isStaffWideAccess() || ownsCohort(existing().cohortId));
    }

    // Audit Logs Collection: Append-only for staff/admins, strictly immutable
    function isValidAuditLog(data) {
      return data.keys().hasAll(['actorId', 'action', 'timestamp']) &&
             data.actorId is string && data.actorId.size() > 0 && data.actorId.size() <= 128 &&
             data.action is string && data.action.size() > 0 && data.action.size() <= 128;
    }

    match /auditLogs/{logId} {
      allow get, list: if isSignedIn() && isTeacherOrAdmin();
      allow create: if isValidId(logId) &&
                       isSignedIn() &&
                       isValidAuditLog(incoming()) &&
                       isTeacherOrAdmin() &&
                       (isAdmin() || incoming().actorId == request.auth.uid);
      allow update, delete: if false;
    }

    // School Settings Collection: Readable by signed-in users; editable only by admins
    function isValidSchoolSetting(data) {
      return data.keys().hasAll(['schoolName', 'schoolMotto']) &&
             data.schoolName is string && data.schoolName.size() > 0 && data.schoolName.size() <= 128 &&
             data.schoolMotto is string && data.schoolMotto.size() > 0 && data.schoolMotto.size() <= 128;
    }

    match /schoolSettings/{settingId} {
      allow get, list: if isSignedIn();
      allow create, update: if isValidId(settingId) &&
                               isSignedIn() &&
                               isValidSchoolSetting(incoming()) &&
                               isAdmin();
      allow delete: if isValidId(settingId) && isAdmin();
    }

    // Weekly Timetables Collection: Enforces teacher cohort ownership + enrolled learner read
    function isValidWeeklyTimetable(data) {
      return data.keys().hasAll(['cohortId', 'programmeTerm', 'weekNumber', 'weekLabel', 'startDate', 'endDate', 'topics']) &&
             data.cohortId is string && data.cohortId.size() > 0 && data.cohortId.size() <= 128 &&
             data.programmeTerm is string && data.programmeTerm.size() > 0 && data.programmeTerm.size() <= 128 &&
             data.weekNumber is number && data.weekNumber >= 1 && data.weekNumber <= 52 &&
             data.weekLabel is string && data.weekLabel.size() > 0 && data.weekLabel.size() <= 128 &&
             data.startDate is string && data.startDate.size() == 10 &&
             data.endDate is string && data.endDate.size() == 10 &&
             data.topics is list && data.topics.size() <= 50 &&
             (!data.keys().hasAny(['levelId']) || data.levelId == null || (data.levelId is string && data.levelId.size() <= 128)) &&
             (!data.keys().hasAny(['levelName']) || data.levelName == null || (data.levelName is string && data.levelName.size() <= 128)) &&
             (!data.keys().hasAny(['classId']) || data.classId == null || (data.classId is string && data.classId.size() <= 128)) &&
             (!data.keys().hasAny(['className']) || data.className == null || (data.className is string && data.className.size() <= 128));
    }

    match /weeklyTimetables/{entryId} {
      allow get, list: if isSignedIn() && (
        isStaffWideAccess() ||
        ownsCohort(resource.data.cohortId) ||
        (isLearnerUser() && (
          resource.data.cohortId in get(/databases/$(database)/documents/learners/$(request.auth.uid)).data.assignedCohortIds
        ))
      );
      allow create, update: if isValidId(entryId) &&
                               isSignedIn() &&
                               isValidWeeklyTimetable(incoming()) &&
                               ownsCohort(incoming().cohortId);
      allow delete: if isValidId(entryId) &&
                       isSignedIn() &&
                       ownsCohort(existing().cohortId);
    }

    // Cohort Levels Collection (e.g. August Holiday Bootcamp Training inside a Cohort)
    function isValidCohortLevel(data) {
      return data.keys().hasAll(['cohortId', 'name', 'status']) &&
             data.cohortId is string && data.cohortId.size() > 0 && data.cohortId.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 128 &&
             data.status in ['active', 'archived'] &&
             (!data.keys().hasAny(['code']) || data.code == null || (data.code is string && data.code.size() <= 64)) &&
             (!data.keys().hasAny(['description']) || data.description == null || (data.description is string && data.description.size() <= 512));
    }

    match /cohortLevels/{levelId} {
      allow get, list: if isSignedIn() && (
        isStaffWideAccess() ||
        ownsCohort(resource.data.cohortId) ||
        (isLearnerUser() && (
          resource.data.cohortId in get(/databases/$(database)/documents/learners/$(request.auth.uid)).data.assignedCohortIds
        ))
      );
      allow create, update: if isValidId(levelId) &&
                               isSignedIn() &&
                               isValidCohortLevel(incoming()) &&
                               ownsCohort(incoming().cohortId);
      allow delete: if isValidId(levelId) &&
                       isSignedIn() &&
                       ownsCohort(existing().cohortId);
    }

    // Cohort Classes Collection (e.g. Lower Primary, Upper Primary, Junior School, Senior School)
    function isValidCohortClass(data) {
      return data.keys().hasAll(['cohortId', 'levelId', 'name', 'code', 'coursesOffered', 'status']) &&
             data.cohortId is string && data.cohortId.size() > 0 && data.cohortId.size() <= 128 &&
             data.levelId is string && data.levelId.size() > 0 && data.levelId.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 128 &&
             data.code is string && data.code.size() > 0 && data.code.size() <= 64 &&
             data.coursesOffered is list && data.coursesOffered.size() <= 50 &&
             data.status in ['active', 'archived'] &&
             (!data.keys().hasAny(['gradeBand']) || data.gradeBand == null || (data.gradeBand is string && data.gradeBand.size() <= 64)) &&
             (!data.keys().hasAny(['ageBracket']) || data.ageBracket == null || (data.ageBracket is string && data.ageBracket.size() <= 64));
    }

    match /cohortClasses/{classId} {
      allow get, list: if isSignedIn() && (
        isStaffWideAccess() ||
        ownsCohort(resource.data.cohortId) ||
        (isLearnerUser() && (
          resource.data.cohortId in get(/databases/$(database)/documents/learners/$(request.auth.uid)).data.assignedCohortIds
        ))
      );
      allow create, update: if isValidId(classId) &&
                               isSignedIn() &&
                               isValidCohortClass(incoming()) &&
                               ownsCohort(incoming().cohortId);
      allow delete: if isValidId(classId) &&
                       isSignedIn() &&
                       ownsCohort(existing().cohortId);
    }
  }
}
