# ==============================================================================
# Sangurur Digital Learner Register (SDLR) - Environment Variables Example
# ==============================================================================
# Copy to .env for local testing (never commit .env files with secrets).
# On Netlify: configure these in Site configuration -> Environment variables,
# then trigger a fresh deploy ("Clear cache and deploy site").
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Firebase Client Configuration (Publicly bundled by Vite into dist/)
# Netlify Scope: Builds (or All). Obtain from Firebase Console -> Project settings
# -> Your apps for project ai-studio-applet-webapp-19cab.
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="ai-studio-applet-webapp-19cab.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="ai-studio-applet-webapp-19cab"
VITE_FIREBASE_STORAGE_BUCKET="ai-studio-applet-webapp-19cab.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID="ai-studio-remixsangururdig-8ba34e88-20b8-4da3-82c1-c3a1c99313d6"
VITE_FIREBASE_MEASUREMENT_ID=""

# ------------------------------------------------------------------------------
# Server-Side / Netlify Functions Variables (KEEP SECRET - NEVER PREFIX WITH VITE_)
# Netlify Scope: Functions (or Runtime)
# ------------------------------------------------------------------------------

# Required in Netlify production: strong random 32+ character hex secret used to sign
# HMAC-SHA256 staff & learner session tokens across serverless invocations.
# Generate with: openssl rand -hex 32
SESSION_SECRET=""

# Initial bootstrap password for the default staff teacher account ("Teacher").
# Only used if teacherCredentials/teacher_default_staff has not been created yet.
DEFAULT_TEACHER_PASSWORD=""

# Required in Netlify production for teacher username/password & learner login APIs:
# Complete single-line Firebase service account JSON for project ai-studio-applet-webapp-19cab
# (Firebase Console -> Project settings -> Service accounts -> Generate new private key).
# Paste the raw JSON object on one line without extra surrounding quotes.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Optional server-side overrides (defaults are read from firebase-applet-config.json):
# FIREBASE_PROJECT_ID="ai-studio-applet-webapp-19cab"
# FIREBASE_DATABASE_ID="ai-studio-remixsangururdig-8ba34e88-20b8-4da3-82c1-c3a1c99313d6"

# Public canonical site URL (used for callbacks/reference if configured)
APP_URL=""

# Optional Gemini API key (server-side only, if AI endpoints are enabled)
GEMINI_API_KEY=""
